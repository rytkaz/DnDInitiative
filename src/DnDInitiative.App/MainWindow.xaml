<Window x:Class="DnDInitiative.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:DnDInitiative.App.Behaviors"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:services="clr-namespace:DnDInitiative.App.Services"
        xmlns:viewModels="clr-namespace:DnDInitiative.App.ViewModels"
        xmlns:views="clr-namespace:DnDInitiative.App.Views"
        Title="{Binding WindowTitle}"
        Width="1400"
        Height="920"
        MinWidth="800"
        MinHeight="480"
        d:DataContext="{d:DesignInstance Type=viewModels:MainViewModel}"
        mc:Ignorable="d">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Command="{Binding OpenCampaignCommand}" Gesture="Ctrl+O" />
        <KeyBinding Command="{Binding SaveCampaignCommand}" Gesture="Ctrl+S" />
        <KeyBinding Command="{Binding SaveCampaignAsCommand}" Gesture="Ctrl+Shift+S" />
    </Window.InputBindings>
    <DockPanel>
        <!--  The top bar: the menus, then a button for each page  -->
        <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                DockPanel.Dock="Top">
            <DockPanel>
                <Menu VerticalAlignment="Center" DockPanel.Dock="Left">
                    <MenuItem Header="_File">
                        <MenuItem Command="{Binding OpenCampaignCommand}"
                                  Header="_Open Campaign..."
                                  InputGestureText="Ctrl+O"
                                  ToolTip="Open another campaign folder, start a new one in an empty folder, or reopen this one to reload it" />
                        <MenuItem Command="{Binding SaveCampaignCommand}"
                                  Header="_Save Campaign"
                                  InputGestureText="Ctrl+S"
                                  ToolTip="Save every encounter, party, stat block and spellbook with unsaved changes" />
                        <MenuItem Command="{Binding SaveCampaignAsCommand}"
                                  Header="Save Campaign _As..."
                                  InputGestureText="Ctrl+Shift+S"
                                  ToolTip="Copy the campaign to an empty folder, switch to the copy, and save the unsaved changes there" />
                        <Separator />
                        <MenuItem Click="OnExitClick"
                                  Header="E_xit"
                                  InputGestureText="Alt+F4" />
                    </MenuItem>
                    <!--  Each import opens in its own window, so the rest of the app stays usable during a long conversion  -->
                    <MenuItem Header="_Import">
                        <MenuItem Command="{Binding ShowImportCommand}"
                                  CommandParameter="{x:Static services:ImportKind.FiveETools}"
                                  Header="_5eTools..."
                                  ToolTip="Convert your 5eTools data and add its stat blocks, spells and conditions to the library" />
                        <MenuItem Command="{Binding ShowImportCommand}"
                                  CommandParameter="{x:Static services:ImportKind.Homebrewery}"
                                  Header="_Homebrewery..."
                                  ToolTip="Download Homebrewery documents and add their stat blocks and conditions to the library" />
                        <MenuItem Command="{Binding ShowImportCommand}"
                                  CommandParameter="{x:Static services:ImportKind.MartialExploits}"
                                  Header="_Martial Exploits (GM Binder)..."
                                  ToolTip="Download GM Binder documents, such as the Alternate Fighter, and add their martial exploits to the library" />
                    </MenuItem>
                </Menu>

                <!--
                    One button per page, like tabs: the selected page is underlined. A list box rather than
                    buttons, because its selection is the current page and the arrow keys move between them.
                -->
                <ListBox Margin="16,0,0,0"
                         VerticalAlignment="Center"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemsSource="{Binding Pages}"
                         KeyboardNavigation.DirectionalNavigation="Cycle"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         SelectedItem="{Binding CurrentPage}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="ToolTip" Value="{Binding Title}" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <!--  Fluent's own item template is made for vertical lists, with a bar at the left of the selected one  -->
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Tab"
                                                Margin="2,4"
                                                Padding="12,4"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="0,0,0,2"
                                                CornerRadius="4,4,0,0">
                                            <TextBlock Text="{Binding ShortTitle}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Tab" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="Tab" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!--  The campaign and the outcome of the last save or reload, on one line at the bottom  -->
        <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                DockPanel.Dock="Bottom">
            <DockPanel Margin="12,2">
                <Button Margin="8,2,0,2"
                        Padding="12,2"
                        Command="{Binding ReloadCampaignCommand}"
                        Content="Reload"
                        DockPanel.Dock="Right"
                        ToolTip="Load the changed files. Unsaved edits and the current combat are discarded."
                        Visibility="{Binding HasPendingExternalChanges, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock VerticalAlignment="Center"
                           DockPanel.Dock="Left"
                           Style="{StaticResource SecondaryText}"
                           Text="Campaign:" />
                <TextBlock MaxWidth="320"
                           Margin="4,0,0,0"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"
                           FontWeight="SemiBold"
                           Text="{Binding CampaignName}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding CampaignName}" />
                <!--  A failed save lists what failed on several lines. The tooltip has them all.  -->
                <TextBlock Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           Text="{Binding CampaignMessageLine}"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="ToolTip" Value="{Binding CampaignMessage}" />
                            <Style.Triggers>
                                <!--  An empty tooltip would still open as a small empty box  -->
                                <DataTrigger Binding="{Binding CampaignMessage}" Value="">
                                    <Setter Property="ToolTip" Value="{x:Null}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </Border>

        <Grid>
            <ContentControl Margin="24" Content="{Binding CurrentPage}">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type viewModels:PartySetupViewModel}">
                        <views:PartySetupView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type viewModels:InitiativeTrackerViewModel}">
                        <views:InitiativeTrackerView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type viewModels:StatBlocksViewModel}">
                        <views:StatBlocksView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type viewModels:EncounterBuilderViewModel}">
                        <views:EncounterBuilderView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type viewModels:SpellbookViewModel}">
                        <views:SpellbookView />
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>

            <!--
                The spell or condition a clicked link refers to. It opens where the mouse is and closes on a click
                anywhere else. Its data context is the spell viewer, set in the code-behind.
            -->
            <Popup x:Name="ReferencePopup"
                   AllowsTransparency="True"
                   IsOpen="{Binding IsOpen, Mode=TwoWay}"
                   Placement="Mouse"
                   PopupAnimation="Fade"
                   StaysOpen="False">
                <!--
                    The size is set on the grid, whose data context is still the viewer; the card's own
                    is the spell or condition. The card is as tall as its text, up to the maximum.
                -->
                <Grid Width="{Binding CardWidth.Value}" MaxHeight="{Binding CardMaxHeight.Value}">
                    <Border BorderBrush="#B8A47E" BorderThickness="1">
                        <views:ReferenceCardView x:Name="ReferenceCard" DataContext="{Binding Details}" />
                    </Border>
                    <Thumb Margin="0,0,2,2"
                           behaviors:ResizeHandle.PanelHeight="{Binding CardMaxHeight}"
                           behaviors:ResizeHandle.PanelWidth="{Binding CardWidth}"
                           Style="{StaticResource BottomRightResizeHandle}" />
                </Grid>
            </Popup>
        </Grid>
    </DockPanel>
</Window>