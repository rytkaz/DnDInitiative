<Window x:Class="DnDInitiative.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:DnDInitiative.App.ViewModels"
        xmlns:views="clr-namespace:DnDInitiative.App.Views"
        Title="{Binding WindowTitle}"
        Width="1400"
        Height="920"
        MinWidth="800"
        MinHeight="480"
        d:DataContext="{d:DesignInstance Type=viewModels:MainViewModel}"
        mc:Ignorable="d">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <!--  As wide as the panel in it, which has two widths: open and folded away  -->
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <DockPanel.Style>
                <Style TargetType="DockPanel">
                    <Style.Triggers>
                        <!--  Open: a fixed width. Folded away: no width set, so as narrow as the vertical tabs.  -->
                        <DataTrigger Binding="{Binding IsNavigationCollapsed}" Value="False">
                            <Setter Property="Width" Value="220" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DockPanel.Style>

            <!--  Folds the panel away, or brings it back  -->
            <Button Width="36"
                    Margin="8"
                    Padding="0,4"
                    HorizontalAlignment="Left"
                    Command="{Binding ToggleNavigationCommand}"
                    Content="☰"
                    DockPanel.Dock="Top"
                    ToolTip="Show or hide the page list" />

            <!--  Folded away: one vertical tab per page, like the tool window tabs at the edge of Visual Studio  -->
            <ListBox ItemsSource="{Binding Pages}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectedItem="{Binding CurrentPage}"
                     Visibility="{Binding IsNavigationCollapsed, Converter={StaticResource BoolToVisibility}}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Margin="0,6"
                                   Text="{Binding ShortTitle}"
                                   ToolTip="{Binding Title}">
                            <!--  Turned a quarter circle, so the text reads from top to bottom  -->
                            <TextBlock.LayoutTransform>
                                <RotateTransform Angle="90" />
                            </TextBlock.LayoutTransform>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!--  Open: the page list and the campaign. Hidden when the panel is folded away.  -->
            <DockPanel>
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNavigationCollapsed}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>

                <!--  The open campaign, below the page list  -->
                <StackPanel Margin="12" DockPanel.Dock="Bottom">
                    <TextBlock Style="{StaticResource SecondaryText}" Text="Campaign" />
                    <TextBlock FontWeight="SemiBold"
                               Text="{Binding CampaignName}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding CampaignName}" />
                    <TextBlock Margin="0,4,0,0"
                               Text="{Binding CampaignMessage}"
                               TextWrapping="Wrap" />
                    <Button Margin="0,8,0,0"
                            Padding="12,4"
                            HorizontalAlignment="Stretch"
                            Command="{Binding ReloadCampaignCommand}"
                            Content="Reload"
                            ToolTip="Load the changed files. Unsaved edits and the current combat are discarded."
                            Visibility="{Binding HasPendingExternalChanges, Converter={StaticResource BoolToVisibility}}" />
                    <Button Margin="0,8,0,0"
                            Padding="12,4"
                            HorizontalAlignment="Stretch"
                            Command="{Binding OpenCampaignCommand}"
                            Content="Open campaign..."
                            ToolTip="Open another campaign folder, start a new one in an empty folder, or reopen this one to reload it" />
                </StackPanel>

                <ListBox DisplayMemberPath="Title"
                         ItemsSource="{Binding Pages}"
                         SelectedItem="{Binding CurrentPage}" />
            </DockPanel>
        </DockPanel>

        <ContentControl Grid.Column="1"
                        Margin="24"
                        Content="{Binding CurrentPage}">
            <ContentControl.Resources>
                <DataTemplate DataType="{x:Type viewModels:PartySetupViewModel}">
                    <views:PartySetupView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewModels:InitiativeTrackerViewModel}">
                    <views:InitiativeTrackerView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewModels:StatBlocksViewModel}">
                    <views:StatBlocksView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewModels:EncounterBuilderViewModel}">
                    <views:EncounterBuilderView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewModels:ImportViewModel}">
                    <views:ImportView />
                </DataTemplate>
            </ContentControl.Resources>
        </ContentControl>

        <!--
            The spell a clicked link refers to. It opens where the mouse is and closes on a click
            anywhere else. Its data context is the spell viewer, set in the code-behind.
        -->
        <Popup x:Name="SpellPopup"
               AllowsTransparency="True"
               IsOpen="{Binding IsOpen, Mode=TwoWay}"
               Placement="Mouse"
               PopupAnimation="Fade"
               StaysOpen="False">
            <Border BorderBrush="#B8A47E" BorderThickness="1">
                <views:SpellDetailsView x:Name="SpellCard"
                                        Width="460"
                                        MaxHeight="620"
                                        DataContext="{Binding Details}" />
            </Border>
        </Popup>
    </Grid>
</Window>