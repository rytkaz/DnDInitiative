<UserControl x:Class="DnDInitiative.App.Views.ClassPickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:DnDInitiative.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewModels:LibraryEditorViewModel}"
             mc:Ignorable="d">
    <!--  The classes the library knows, to tick, and a box for any class it does not  -->
    <StackPanel>
        <TextBlock Text="Classes" />
        <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding ClassChoices}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type viewModels:ClassChoiceViewModel}">
                    <CheckBox MinWidth="0"
                              Margin="0,0,16,4"
                              Content="{Binding Name}"
                              IsChecked="{Binding IsSelected}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBox Margin="0,4,0,0"
                 Text="{Binding OtherClasses, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="Other classes, separated by commas" />
    </StackPanel>
</UserControl>
