<UserControl x:Class="DnDInitiative.App.Views.StatBlocksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:DnDInitiative.App.Behaviors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:formatting="clr-namespace:DnDInitiative.App.Formatting"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:DnDInitiative.App.ViewModels"
             xmlns:views="clr-namespace:DnDInitiative.App.Views"
             d:DataContext="{d:DesignInstance Type=viewModels:StatBlocksViewModel}"
             d:DesignHeight="600"
             d:DesignWidth="900"
             Loaded="OnLoaded"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!--  The list is as wide as the user dragged it; the gap holds the drag strip.  -->
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Thumb Grid.Column="1"
               behaviors:ResizeHandle.PanelWidth="{Binding ListWidth}"
               Style="{StaticResource ColumnResizeHandle}" />

        <!--  Left: search and list  -->
        <DockPanel Grid.Column="0"
                   Width="{Binding ListWidth.Value}"
                   IsEnabled="{Binding IsBrowsing}">
            <TextBlock DockPanel.Dock="Top"
                       Style="{StaticResource PageTitle}"
                       Text="{Binding Title}" />
            <TextBlock DockPanel.Dock="Top" Text="Search" />
            <TextBox Margin="0,4,0,8"
                     DockPanel.Dock="Top"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

            <WrapPanel Margin="0,8,0,0" DockPanel.Dock="Bottom">
                <Button Margin="0,0,8,0"
                        Padding="12,4"
                        Command="{Binding NewCommand}"
                        Content="New" />
                <Button Margin="0,0,8,0"
                        Padding="12,4"
                        Command="{Binding EditCommand}"
                        Content="Edit" />
                <Button Margin="0,0,8,0"
                        Padding="12,4"
                        Command="{Binding CopyCommand}"
                        Content="Copy" />
                <Button Padding="12,4"
                        Command="{Binding DeleteCommand}"
                        Content="Delete" />
            </WrapPanel>
            <TextBlock Margin="0,8,0,0"
                       DockPanel.Dock="Bottom"
                       Text="{Binding StatusMessage}"
                       TextWrapping="Wrap" />

            <ListBox behaviors:LoadMoreOnScroll.Command="{Binding LoadMoreCommand}"
                     ItemTemplate="{StaticResource StatBlockSummaryTemplate}"
                     ItemsSource="{Binding FilteredStatBlocks}"
                     SelectedItem="{Binding SelectedStatBlock}"
                     TextSearch.TextPath="Name" />
        </DockPanel>

        <!--  Right: viewer  -->
        <ScrollViewer Grid.Column="2"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsBrowsing, Converter={StaticResource BoolToVisibility}}">
            <views:StatBlockDetailsView DataContext="{Binding Details}" />
        </ScrollViewer>

        <!--  Right: editor  -->
        <DockPanel Grid.Column="2" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Margin="0,12,0,0"
                        DockPanel.Dock="Bottom"
                        Orientation="Horizontal">
                <Button Padding="24,4"
                        Command="{Binding SaveCommand}"
                        Content="Save" />
                <Button Margin="8,0,0,0"
                        Padding="12,4"
                        Command="{Binding CancelCommand}"
                        Content="Cancel" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,12,0" DataContext="{Binding Editor}">
                    <TextBlock Text="Name" />
                    <TextBox Margin="0,4,0,12" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                    <ItemsControl ItemsSource="{Binding NumberFields}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="90" Margin="0,0,8,12">
                                    <TextBlock Text="{Binding Label}" />
                                    <TextBox Margin="0,4,0,0" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding TextFields}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Label}" />
                                    <TextBox Margin="0,4,0,0" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding FeatureLists}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,16,0,0">
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Title}" />
                                    <Separator Margin="0,2,0,6" />

                                    <!--  The text before the entries, such as how many legendary actions there are  -->
                                    <TextBox MinHeight="48"
                                             Margin="0,0,0,8"
                                             AcceptsReturn="True"
                                             Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                             TextWrapping="Wrap"
                                             ToolTip="Shown before the entries of this section"
                                             Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibility}}" />

                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0"
                                                             VerticalAlignment="Top"
                                                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBox Grid.Column="2"
                                                             MinHeight="48"
                                                             AcceptsReturn="True"
                                                             Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                                             TextWrapping="Wrap" />
                                                    <!--
                                                        Inside the row the data context is one feature. The commands belong to
                                                        the list around it, and each takes this row's feature as its parameter.
                                                    -->
                                                    <StackPanel Grid.Column="4"
                                                                VerticalAlignment="Top"
                                                                Orientation="Horizontal">
                                                        <Button Padding="8,2"
                                                                Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                Content="▲"
                                                                ToolTip="Move up" />
                                                        <Button Margin="4,0,0,0"
                                                                Padding="8,2"
                                                                Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                Content="▼"
                                                                ToolTip="Move down" />
                                                        <Button Margin="8,0,0,0"
                                                                Padding="8,2"
                                                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                Content="Remove" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Button Padding="12,4"
                                            HorizontalAlignment="Left"
                                            Command="{Binding AddCommand}"
                                            Content="Add" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>