<UserControl x:Class="DnDInitiative.App.Views.StatBlocksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:DnDInitiative.App.ViewModels"
             xmlns:formatting="clr-namespace:DnDInitiative.App.Formatting"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:StatBlocksViewModel}"
             d:DesignWidth="900"
             d:DesignHeight="600"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- "Label value" on one wrapping line, with the label in bold. -->
        <DataTemplate x:Key="LabeledValueTemplate">
            <TextBlock Margin="0,2" TextWrapping="Wrap">
                <Run FontWeight="Bold" Text="{Binding Label, Mode=OneWay}" />
                <Span formatting:MarkdownText.Text="{Binding Value}" />
            </TextBlock>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: search and list -->
        <DockPanel Grid.Column="0" IsEnabled="{Binding IsBrowsing}">
            <TextBlock DockPanel.Dock="Top"
                       Margin="0,0,0,12"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Text="{Binding Title}" />
            <TextBlock DockPanel.Dock="Top" Text="Search" />
            <TextBox DockPanel.Dock="Top"
                     Margin="0,4,0,8"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

            <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button Margin="0,0,8,0"
                        Padding="12,4"
                        Command="{Binding NewCommand}"
                        Content="New" />
                <Button Margin="0,0,8,0"
                        Padding="12,4"
                        Command="{Binding EditCommand}"
                        Content="Edit" />
                <Button Margin="0,0,8,0"
                        Padding="12,4"
                        Command="{Binding CopyCommand}"
                        Content="Copy" />
                <Button Padding="12,4"
                        Command="{Binding DeleteCommand}"
                        Content="Delete" />
                <Button Margin="8,0,0,0"
                        Padding="12,4"
                        Command="{Binding ImportCommand}"
                        Content="Import..." />
            </WrapPanel>
            <TextBlock DockPanel.Dock="Bottom"
                       Margin="0,8,0,0"
                       Text="{Binding StatusMessage}"
                       TextWrapping="Wrap" />

            <ListBox DisplayMemberPath="Name"
                     ItemsSource="{Binding FilteredStatBlocks}"
                     SelectedItem="{Binding SelectedStatBlock}" />
        </DockPanel>

        <!-- Right: viewer -->
        <ScrollViewer Grid.Column="2"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsBrowsing, Converter={StaticResource BoolToVisibility}}">
            <StackPanel DataContext="{Binding Details}">
                <TextBlock FontSize="26"
                           FontWeight="SemiBold"
                           Text="{Binding Name}" />
                <TextBlock Margin="0,0,0,12"
                           FontStyle="Italic"
                           Text="{Binding Summary}" />

                <ItemsControl ItemTemplate="{StaticResource LabeledValueTemplate}" ItemsSource="{Binding CoreStats}" />

                <ItemsControl Margin="0,12" ItemsSource="{Binding Abilities}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock HorizontalAlignment="Center"
                                           FontWeight="Bold"
                                           Text="{Binding Label}" />
                                <TextBlock HorizontalAlignment="Center" Text="{Binding Value}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemTemplate="{StaticResource LabeledValueTemplate}" ItemsSource="{Binding OtherStats}" />

                <ItemsControl ItemsSource="{Binding Sections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,16,0,0">
                                <TextBlock FontSize="18"
                                           FontWeight="SemiBold"
                                           Text="{Binding Title}" />
                                <Separator Margin="0,2,0,6" />
                                <ItemsControl ItemTemplate="{StaticResource LabeledValueTemplate}" ItemsSource="{Binding Entries}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Right: editor -->
        <DockPanel Grid.Column="2" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
            <StackPanel DockPanel.Dock="Bottom"
                        Margin="0,12,0,0"
                        Orientation="Horizontal">
                <Button Padding="24,4"
                        Command="{Binding SaveCommand}"
                        Content="Save" />
                <Button Margin="8,0,0,0"
                        Padding="12,4"
                        Command="{Binding CancelCommand}"
                        Content="Cancel" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,12,0" DataContext="{Binding Editor}">
                    <TextBlock Text="Name" />
                    <TextBox Margin="0,4,0,12" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                    <ItemsControl ItemsSource="{Binding NumberFields}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="90" Margin="0,0,8,12">
                                    <TextBlock Text="{Binding Label}" />
                                    <TextBox Margin="0,4,0,0" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding TextFields}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Label}" />
                                    <TextBox Margin="0,4,0,0" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding FeatureLists}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,16,0,0">
                                    <TextBlock FontSize="18"
                                               FontWeight="SemiBold"
                                               Text="{Binding Title}" />
                                    <Separator Margin="0,2,0,6" />

                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0"
                                                             VerticalAlignment="Top"
                                                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBox Grid.Column="2"
                                                             MinHeight="48"
                                                             AcceptsReturn="True"
                                                             Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                                             TextWrapping="Wrap" />
                                                    <Button Grid.Column="4"
                                                            Padding="8,2"
                                                            VerticalAlignment="Top"
                                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Content="Remove" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Button Padding="12,4"
                                            HorizontalAlignment="Left"
                                            Command="{Binding AddCommand}"
                                            Content="Add" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>