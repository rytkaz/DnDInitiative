<UserControl x:Class="DnDInitiative.App.Views.SpellEditorView"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:viewModels="clr-namespace:DnDInitiative.App.ViewModels"
                  xmlns:views="clr-namespace:DnDInitiative.App.Views"
                  d:DataContext="{d:DesignInstance Type=viewModels:SpellEditorViewModel}"
                  mc:Ignorable="d">
    <StackPanel>
        <TextBlock Text="Name" />
        <TextBox Margin="0,4,0,12" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Level" />
                <ComboBox Margin="0,4,0,0"
                          HorizontalAlignment="Stretch"
                          DisplayMemberPath="Label"
                          ItemsSource="{Binding LevelOptions}"
                          SelectedValue="{Binding Level}"
                          SelectedValuePath="Value" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="School" />
                <ComboBox Margin="0,4,0,0"
                          HorizontalAlignment="Stretch"
                          IsEditable="True"
                          ItemsSource="{Binding Schools}"
                          Text="{Binding School, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Grid>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Casting time" />
                <TextBox Margin="0,4,0,0" Text="{Binding CastingTime, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Range" />
                <TextBox Margin="0,4,0,0" Text="{Binding Range, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="Duration" />
                <TextBox Margin="0,4,0,0" Text="{Binding Duration, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Grid>

        <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
            <CheckBox MinWidth="0"
                      Margin="0,0,24,0"
                      Content="Concentration"
                      IsChecked="{Binding IsConcentration}"
                      ToolTip="Ticked here, not read from the duration text" />
            <CheckBox MinWidth="0"
                      Content="Ritual"
                      IsChecked="{Binding IsRitual}" />
        </StackPanel>

        <TextBlock Text="Components" />
        <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
            <CheckBox MinWidth="0"
                      Margin="0,0,16,0"
                      Content="V"
                      IsChecked="{Binding HasVerbal}"
                      ToolTip="Verbal" />
            <CheckBox MinWidth="0"
                      Margin="0,0,16,0"
                      Content="S"
                      IsChecked="{Binding HasSomatic}"
                      ToolTip="Somatic" />
            <CheckBox MinWidth="0"
                      Content="M"
                      IsChecked="{Binding HasMaterial}"
                      ToolTip="Material" />
        </StackPanel>
        <TextBox Margin="0,4,0,12"
                 IsEnabled="{Binding HasMaterial}"
                 Text="{Binding MaterialText, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="What the material component is" />

        <views:ClassPickerView Margin="0,0,0,12" />

        <TextBlock Text="Source" />
        <TextBox Margin="0,4,0,12"
                 Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="Part of the key for a new spell, so the same name can exist in two sources" />

        <TextBlock Text="Description (Markdown)" />
        <TextBox MinHeight="200"
                 Margin="0,4,0,0"
                 AcceptsReturn="True"
                 Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" />
        <TextBlock Margin="0,4,0,0"
                   Style="{StaticResource SecondaryText}"
                   Text="Put 'At Higher Levels' at the end of the description."
                   TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
