<UserControl x:Class="DnDInitiative.App.Views.PartySetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:DnDInitiative.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:PartySetupViewModel}"
             d:DesignWidth="900"
             d:DesignHeight="600"
             Loaded="OnLoaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: the list of parties -->
        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top"
                       Style="{StaticResource PageTitle}"
                       Text="{Binding Title}" />

            <StackPanel DockPanel.Dock="Bottom"
                        Margin="0,8,0,0"
                        Orientation="Horizontal">
                <Button Padding="12,4"
                        Command="{Binding NewPartyCommand}"
                        Content="New party" />
                <Button Margin="8,0,0,0"
                        Padding="12,4"
                        Command="{Binding DeleteCommand}"
                        Content="Delete" />
            </StackPanel>

            <ListBox DisplayMemberPath="Name"
                     ItemsSource="{Binding Parties}"
                     SelectedItem="{Binding SelectedParty}" />
        </DockPanel>

        <!-- Right: the editor for the selected party -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0"
                       DataContext="{Binding SelectedParty}"
                       d:DataContext="{d:DesignInstance Type=viewModels:PartyEditorViewModel}">
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>

                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Party name" />
                    <TextBox Margin="0,4,0,16"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Members" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom"
                            Margin="0,8,0,0"
                            Orientation="Horizontal">
                    <Button Padding="12,4"
                            Command="{Binding AddMemberCommand}"
                            Content="Add member" />
                    <Button Margin="8,0,0,0"
                            Padding="12,4"
                            Command="{Binding RemoveMemberCommand}"
                            Content="Remove member" />
                </StackPanel>

                <DataGrid Margin="0,4,0,0"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          ItemsSource="{Binding Members}"
                          SelectedItem="{Binding SelectedMember}"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="*"
                                            Binding="{Binding Name}"
                                            Header="Name" />
                        <DataGridTextColumn Width="80"
                                            Binding="{Binding Level}"
                                            Header="Level" />
                        <DataGridTextColumn Width="80"
                                            Binding="{Binding MaxHp, TargetNullValue=''}"
                                            Header="Max HP" />
                        <DataGridTextColumn Width="80"
                                            Binding="{Binding ArmorClass, TargetNullValue=''}"
                                            Header="AC" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <StackPanel Grid.Row="1"
                        Margin="0,16,0,0"
                        Orientation="Horizontal">
                <Button Padding="24,4"
                        Command="{Binding SaveCommand}"
                        Content="Save" />
                <TextBlock Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Text="{Binding StatusMessage}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>