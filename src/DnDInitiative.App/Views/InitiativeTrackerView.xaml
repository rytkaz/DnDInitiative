<UserControl x:Class="DnDInitiative.App.Views.InitiativeTrackerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:DnDInitiative.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:InitiativeTrackerViewModel}"
             d:DesignWidth="900"
             d:DesignHeight="600"
             Loaded="OnLoaded">
    <DockPanel>
        <!-- Header: title, party, round, turn controls -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <TextBlock Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           Text="Party" />
                <ComboBox Width="160"
                          DisplayMemberPath="Name"
                          ItemsSource="{Binding Parties}"
                          SelectedItem="{Binding SelectedParty}" />
                <Button Margin="8,0,0,0"
                        Padding="12,4"
                        Command="{Binding NewCombatCommand}"
                        Content="New combat" />
                <TextBlock Margin="24,0,16,0"
                           VerticalAlignment="Center"
                           FontSize="18"
                           Text="{Binding Round, StringFormat='Round {0}'}" />
                <Button Padding="12,4"
                        Command="{Binding PreviousCommand}"
                        Content="Previous" />
                <Button Margin="8,0,0,0"
                        Padding="12,4"
                        Command="{Binding NextCommand}"
                        Content="Next" />
            </StackPanel>
            <TextBlock FontSize="28"
                       FontWeight="SemiBold"
                       Text="{Binding Title}" />
        </DockPanel>

        <!-- Footer: add and remove creatures -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <StackPanel Width="200">
                    <TextBlock Text="Name" />
                    <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Width="60" Margin="8,0,0,0">
                    <TextBlock Text="Count" />
                    <TextBox Text="{Binding NewQuantity, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Width="60" Margin="8,0,0,0">
                    <TextBlock Text="Init mod" />
                    <TextBox Text="{Binding NewInitiativeModifier, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Width="60" Margin="8,0,0,0">
                    <TextBlock Text="Max HP" />
                    <TextBox Text="{Binding NewMaxHp, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Width="60" Margin="8,0,0,0">
                    <TextBlock Text="AC" />
                    <TextBox Text="{Binding NewArmorClass, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <Button Margin="8,0,0,0"
                        Padding="12,4"
                        VerticalAlignment="Bottom"
                        Command="{Binding AddCreatureCommand}"
                        Content="Add" />
                <Button Margin="24,0,0,0"
                        Padding="12,4"
                        VerticalAlignment="Bottom"
                        Command="{Binding RemoveSelectedCommand}"
                        Content="Remove selected" />
            </StackPanel>
            <CheckBox Margin="0,8,0,0"
                      Content="Roll initiative with disadvantage"
                      IsChecked="{Binding RollWithDisadvantage}" />
        </StackPanel>

        <!-- Turn order -->
        <DataGrid AllowDrop="True"
                  AutoGenerateColumns="False"
                  CanUserSortColumns="False"
                  HeadersVisibility="Column"
                  IsReadOnly="True"
                  ItemsSource="{Binding Combatants}"
                  PreviewDragOver="OnGridPreviewDragOver"
                  PreviewDrop="OnGridPreviewDrop"
                  PreviewMouseLeftButtonDown="OnGridPreviewMouseLeftButtonDown"
                  PreviewMouseMove="OnGridPreviewMouseMove"
                  SelectedItem="{Binding SelectedCombatant}"
                  SelectionMode="Single">
            <DataGrid.Resources>
                <!-- Applies to every TextBox inside the grid's cells. -->
                <Style TargetType="TextBox">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <EventSetter Event="KeyDown" Handler="OnCellTextBoxKeyDown" />
                </Style>
            </DataGrid.Resources>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                            <Setter Property="Background" Value="#FFF3D6" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="28" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Cursor="SizeAll"
                       Tag="DragHandle"
                       Text="≡"
                       TextAlignment="Center"
                       ToolTip="Drag to reorder" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Width="*"
                                    Binding="{Binding Name, Mode=OneWay}"
                                    Header="Name" />

                <DataGridTemplateColumn Width="90" Header="Initiative">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Initiative}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="110" Header="HP">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <ToggleButton Content="{Binding HpText}" IsEnabled ="{Binding CanChangeHp}" IsChecked="{Binding IsHpEditorOpen}">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Style.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="IsHitTestVisible" Value="False" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <Popup IsOpen="{Binding IsHpEditorOpen, Mode=TwoWay}"
                                       Opened="OnHpPopupOpened"
                                       Placement="Bottom"
                                       StaysOpen="False">
                                    <Border Padding="8"
                                            Background="White"
                                            BorderBrush="Gray"
                                            BorderThickness="1">
                                        <StackPanel>
                                            <TextBox Width="140"
                                                     BorderThickness="1"
                                                     Text="{Binding HpChangeAmount, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}" />
                                            <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                                <Button Padding="8,2"
                                                        Command="{Binding DamageCommand}"
                                                        Content="Damage"
                                                        IsDefault="True" />
                                                <Button Margin="8,0,0,0"
                                                        Padding="8,2"
                                                        Command="{Binding HealCommand}"
                                                        Content="Heal" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="70" Header="Max HP">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding MaxHp, TargetNullValue=''}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="70" Header="AC">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding ArmorClass, TargetNullValue=''}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>