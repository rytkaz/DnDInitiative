<UserControl x:Class="DnDInitiative.App.Views.InitiativeTrackerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:DnDInitiative.App.Behaviors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:DnDInitiative.App.ViewModels"
             xmlns:views="clr-namespace:DnDInitiative.App.Views"
             d:DataContext="{d:DesignInstance Type=viewModels:InitiativeTrackerViewModel}"
             d:DesignHeight="600"
             d:DesignWidth="900"
             Loaded="OnLoaded"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <!--  One popup shared by every row. The code-behind points it at the clicked row.  -->
        <Popup x:Key="HpPopup"
               Opened="OnHpPopupOpened"
               Placement="Bottom"
               StaysOpen="False">
            <Border Padding="8"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                <StackPanel>
                    <TextBox MinWidth="140" Text="{Binding HpChangeAmount, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <Button Padding="8,2"
                                Click="OnHpPopupActionClick"
                                Command="{Binding DamageCommand}"
                                Content="Damage"
                                IsDefault="True" />
                        <Button Margin="8,0,0,0"
                                Padding="8,2"
                                Click="OnHpPopupActionClick"
                                Command="{Binding HealCommand}"
                                Content="Heal" />
                        <Button Margin="8,0,0,0"
                                Padding="8,2"
                                Click="OnHpPopupActionClick"
                                Command="{Binding SetHpCommand}"
                                Content="Set to" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
        <!--  Add a creature by typing its numbers.  -->
        <Popup x:Key="AddCreaturePopup"
               Opened="OnAddPopupOpened"
               Placement="Top"
               StaysOpen="False">
            <Border Padding="12"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                <StackPanel Width="340">
                    <TextBlock Text="Name" />
                    <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" />

                    <UniformGrid Margin="0,8,0,0" Columns="4">
                        <StackPanel Margin="0,0,4,0">
                            <TextBlock Text="Count" />
                            <TextBox Text="{Binding NewQuantity, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="4,0">
                            <TextBlock Text="Init mod" />
                            <TextBox Text="{Binding NewInitiativeModifier, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="4,0">
                            <TextBlock Text="Max HP" />
                            <TextBox Text="{Binding NewMaxHp, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="4,0,0,0">
                            <TextBlock Text="AC" />
                            <TextBox Text="{Binding NewArmorClass, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </UniformGrid>

                    <Button Margin="0,12,0,0"
                            Padding="12,4"
                            HorizontalAlignment="Right"
                            Command="{Binding AddCreatureCommand}"
                            Content="Add to combat"
                            IsDefault="True" />
                </StackPanel>
            </Border>
        </Popup>

        <!--  Add a creature from the stat block library.  -->
        <Popup x:Key="AddFromLibraryPopup"
               Opened="OnAddPopupOpened"
               Placement="Top"
               StaysOpen="False">
            <Border Padding="12"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                <DockPanel Width="340" Height="380">
                    <TextBox Margin="0,0,0,8"
                             DockPanel.Dock="Top"
                             Text="{Binding LibrarySearchText, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel Margin="0,8,0,0"
                                HorizontalAlignment="Right"
                                DockPanel.Dock="Bottom"
                                Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="Count" />
                        <TextBox Width="60"
                                 Margin="8,0,0,0"
                                 Text="{Binding NewQuantity, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Margin="8,0,0,0"
                                Padding="12,4"
                                Command="{Binding AddFromLibraryCommand}"
                                Content="Add to combat" />
                    </StackPanel>

                    <ListBox behaviors:LoadMoreOnScroll.Command="{Binding LoadMoreLibraryResultsCommand}"
                             ItemTemplate="{StaticResource StatBlockSummaryTemplate}"
                             ItemsSource="{Binding LibraryResults}"
                             SelectedItem="{Binding SelectedLibraryStatBlock}"
                             TextSearch.TextPath="Name" />
                </DockPanel>
            </Border>
        </Popup>
    </UserControl.Resources>
    <DockPanel>
        <!--  Header: title, party, round, turn controls  -->
        <DockPanel Margin="0,0,0,12" DockPanel.Dock="Top">
            <StackPanel VerticalAlignment="Center"
                        DockPanel.Dock="Right"
                        Orientation="Horizontal">
                <TextBlock Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           Text="Party" />
                <ComboBox Width="160"
                          DisplayMemberPath="Name"
                          ItemsSource="{Binding Parties}"
                          SelectedItem="{Binding SelectedParty}" />
                <Button Margin="4,0,0,0"
                        Padding="8,4"
                        Command="{Binding ClearPartyCommand}"
                        Content="✕"
                        ToolTip="No party" />
                <Button Margin="8,0,0,0"
                        Padding="12,4"
                        Command="{Binding NewCombatCommand}"
                        Content="New combat" />
                <TextBlock Margin="24,0,16,0"
                           VerticalAlignment="Center"
                           FontSize="18"
                           Text="{Binding Round, StringFormat='Round {0}'}" />
                <Button Padding="12,4"
                        Command="{Binding PreviousCommand}"
                        Content="Previous" />
                <Button Margin="8,0,0,0"
                        Padding="12,4"
                        Command="{Binding NextCommand}"
                        Content="Next" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Margin="0"
                           Style="{StaticResource PageTitle}"
                           Text="{Binding Title}" />
                <TextBlock Margin="16,0,0,4"
                           VerticalAlignment="Bottom"
                           FontSize="18"
                           Style="{StaticResource SecondaryText}"
                           Text="{Binding CombatName}" />
            </StackPanel>
        </DockPanel>

        <!--  Footer: actions on the left, options on the right  -->
        <DockPanel Margin="0,12,0,0" DockPanel.Dock="Bottom">
            <StackPanel VerticalAlignment="Center"
                        DockPanel.Dock="Right"
                        Orientation="Horizontal">
                <CheckBox Content="Disadvantage"
                          IsChecked="{Binding RollWithDisadvantage}"
                          ToolTip="Roll creature initiative with disadvantage" />
                <CheckBox Margin="16,0,0,0"
                          Content="Stat block panel"
                          IsChecked="{Binding ShowStatBlockPanel}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Button Padding="12,4"
                        Click="OnOpenPopupClick"
                        Content="Add creature..."
                        Tag="AddCreaturePopup" />
                <Button Margin="8,0,0,0"
                        Padding="12,4"
                        Click="OnOpenPopupClick"
                        Content="Add from library..."
                        Tag="AddFromLibraryPopup" />
                <Button Margin="24,0,0,0"
                        Padding="12,4"
                        Command="{Binding RerollInitiativeCommand}"
                        Content="Reroll initiative"
                        ToolTip="Roll again for every creature. Players keep their initiative." />
                <Button Margin="8,0,0,0"
                        Padding="12,4"
                        Command="{Binding RemoveSelectedCommand}"
                        Content="Remove selected" />
            </StackPanel>
        </DockPanel>

        <!--  Library picker, and the stat block of whatever was clicked last  -->
        <Border Width="{Binding StatBlockPanelWidth}"
                DockPanel.Dock="Right"
                Style="{StaticResource PanelBorder}"
                Visibility="{Binding ShowStatBlockPanel, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <views:StatBlockDetailsView Margin="0,0,8,0" DataContext="{Binding StatBlockDetails}" />
            </ScrollViewer>
        </Border>
        <!--  Drag strip between the turn order and the panel  -->
        <Thumb Width="12"
               Cursor="SizeWE"
               DockPanel.Dock="Right"
               DragCompleted="OnPanelResizeDragCompleted"
               DragDelta="OnPanelResizeDragDelta"
               ToolTip="Drag to resize"
               Visibility="{Binding ShowStatBlockPanel, Converter={StaticResource BoolToVisibility}}">
            <Thumb.Template>
                <ControlTemplate>
                    <!--  Transparent, but still catches the mouse. With no background at all, clicks would pass through.  -->
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
        <!--  Turn order  -->
        <DataGrid behaviors:ClearSelectionOnEmptyClick.IsEnabled="True"
                  AllowDrop="True"
                  AutoGenerateColumns="False"
                  CanUserSortColumns="False"
                  HeadersVisibility="Column"
                  IsReadOnly="True"
                  ItemsSource="{Binding Combatants}"
                  PreviewDragLeave="OnGridPreviewDragLeave"
                  PreviewDragOver="OnGridPreviewDragOver"
                  PreviewDrop="OnGridPreviewDrop"
                  PreviewMouseLeftButtonDown="OnGridPreviewMouseLeftButtonDown"
                  PreviewMouseMove="OnGridPreviewMouseMove"
                  SelectedItem="{Binding SelectedCombatant}"
                  SelectionMode="Single">
            <DataGrid.Resources>
                <!--  Applies to every TextBox inside the grid's cells.  -->
                <Style BasedOn="{StaticResource {x:Type TextBox}}" TargetType="TextBox">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <EventSetter Event="KeyDown" Handler="OnCellTextBoxKeyDown" />
                </Style>
            </DataGrid.Resources>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <!--  Without this, the rows get the old theme's white background.  -->
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridRow">
                                <Grid>
                                    <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                        <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                    </Border>

                                    <!--  Drawn over the row's edge while something is dragged onto it.  -->
                                    <Border x:Name="DropLine"
                                            Height="2"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                                            IsHitTestVisible="False"
                                            Visibility="Collapsed" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="behaviors:DropIndicator.Position" Value="Above">
                                        <Setter TargetName="DropLine" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                    <Trigger Property="behaviors:DropIndicator.Position" Value="Below">
                                        <Setter TargetName="DropLine" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="DropLine" Property="VerticalAlignment" Value="Bottom" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="28" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Cursor="SizeAll"
                                       Tag="DragHandle"
                                       Text="≡"
                                       TextAlignment="Center"
                                       ToolTip="Drag to reorder" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="90" Header="Initiative">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Initiative}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Width="*"
                                    Binding="{Binding Name, Mode=OneWay}"
                                    Header="Name" />

                <DataGridTemplateColumn Width="110" Header="HP">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Click="OnHpButtonClick"
                                    Content="{Binding HpText}"
                                    IsEnabled="{Binding TracksHp}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="70" Header="Max HP">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding MaxHp, TargetNullValue=''}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="70" Header="AC">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding ArmorClass, TargetNullValue=''}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>