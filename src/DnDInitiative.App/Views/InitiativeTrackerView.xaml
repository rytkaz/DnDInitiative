<UserControl x:Class="DnDInitiative.App.Views.InitiativeTrackerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:DnDInitiative.App.ViewModels"
             xmlns:views="clr-namespace:DnDInitiative.App.Views"
             xmlns:behaviors="clr-namespace:DnDInitiative.App.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:InitiativeTrackerViewModel}"
             d:DesignWidth="900"
             d:DesignHeight="600"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <!-- One popup shared by every row. The code-behind points it at the clicked row. -->
        <Popup x:Key="HpPopup"
           Opened="OnHpPopupOpened"
           Placement="Bottom"
           StaysOpen="False">
            <Border Padding="8"
                Background="White"
                BorderBrush="Gray"
                BorderThickness="1">
                <StackPanel>
                    <TextBox Width="140" Text="{Binding HpChangeAmount, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <Button Padding="8,2"
                            Click="OnHpPopupActionClick"
                            Command="{Binding DamageCommand}"
                            Content="Damage"
                            IsDefault="True" />
                        <Button Margin="8,0,0,0"
                            Padding="8,2"
                            Click="OnHpPopupActionClick"
                            Command="{Binding HealCommand}"
                            Content="Heal" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </UserControl.Resources>
    <DockPanel>
        <!-- Header: title, party, round, turn controls -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <TextBlock Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           Text="Party" />
                <ComboBox Width="160"
                          DisplayMemberPath="Name"
                          ItemsSource="{Binding Parties}"
                          SelectedItem="{Binding SelectedParty}" />
                <Button Margin="4,0,0,0"
                        Padding="8,4"
                        Command="{Binding ClearPartyCommand}"
                        Content="✕"
                        ToolTip="No party" />
                <Button Margin="8,0,0,0"
                        Padding="12,4"
                        Command="{Binding NewCombatCommand}"
                        Content="New combat" />
                <TextBlock Margin="24,0,16,0"
                           VerticalAlignment="Center"
                           FontSize="18"
                           Text="{Binding Round, StringFormat='Round {0}'}" />
                <Button Padding="12,4"
                        Command="{Binding PreviousCommand}"
                        Content="Previous" />
                <Button Margin="8,0,0,0"
                        Padding="12,4"
                        Command="{Binding NextCommand}"
                        Content="Next" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock FontSize="28"
                           FontWeight="SemiBold"
                           Text="{Binding Title}" />
                <TextBlock Margin="16,0,0,4"
                           VerticalAlignment="Bottom"
                           FontSize="18"
                           Foreground="Gray"
                           Text="{Binding CombatName}" />
            </StackPanel>
        </DockPanel>

        <!-- Footer: add and remove creatures -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <StackPanel Width="200">
                    <TextBlock Text="Name" />
                    <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Width="60" Margin="8,0,0,0">
                    <TextBlock Text="Count" />
                    <TextBox Text="{Binding NewQuantity, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Width="60" Margin="8,0,0,0">
                    <TextBlock Text="Init mod" />
                    <TextBox Text="{Binding NewInitiativeModifier, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Width="60" Margin="8,0,0,0">
                    <TextBlock Text="Max HP" />
                    <TextBox Text="{Binding NewMaxHp, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Width="60" Margin="8,0,0,0">
                    <TextBlock Text="AC" />
                    <TextBox Text="{Binding NewArmorClass, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <Button Margin="8,0,0,0"
                        Padding="12,4"
                        VerticalAlignment="Bottom"
                        Command="{Binding AddCreatureCommand}"
                        Content="Add" />
                <Button Margin="24,0,0,0"
                        Padding="12,4"
                        VerticalAlignment="Bottom"
                        Command="{Binding RemoveSelectedCommand}"
                        Content="Remove selected" />
            </StackPanel>
            <CheckBox Margin="0,8,0,0"
                      Content="Roll initiative with disadvantage"
                      IsChecked="{Binding RollWithDisadvantage}" />
            <CheckBox Margin="0,4,0,0"
                      Content="Show the library and stat block panel"
                      IsChecked="{Binding ShowStatBlockPanel}" />
        </StackPanel>

        <!-- Library picker, and the stat block of whatever was clicked last -->
        <Border DockPanel.Dock="Right"
        Width="380"
        Margin="12,0,0,0"
        Padding="12"
        BorderBrush="LightGray"
        BorderThickness="1"
        Visibility="{Binding ShowStatBlockPanel, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <Expander DockPanel.Dock="Top" IsExpanded="{Binding IsLibraryExpanded}">
                    <Expander.Header>
                        <TextBlock FontWeight="SemiBold" Text="Add from library" />
                    </Expander.Header>

                    <DockPanel Height="190" Margin="0,4,0,0">
                        <TextBox DockPanel.Dock="Top"
                 Margin="0,0,0,4"
                 Text="{Binding LibrarySearchText, UpdateSourceTrigger=PropertyChanged}" />

                        <StackPanel DockPanel.Dock="Bottom"
                    Margin="0,4,0,0"
                    Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="Count" />
                            <TextBox Width="40"
                     Margin="8,0,0,0"
                     VerticalContentAlignment="Center"
                     Text="{Binding NewQuantity, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Margin="8,0,0,0"
                    Padding="12,4"
                    Command="{Binding AddFromLibraryCommand}"
                    Content="Add to combat" />
                        </StackPanel>

                        <ListBox behaviors:LoadMoreOnScroll.Command="{Binding LoadMoreLibraryResultsCommand}"
                 ItemsSource="{Binding LibraryResults}"
                 SelectedItem="{Binding SelectedLibraryStatBlock}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                        <Run Text="{Binding Name, Mode=OneWay}" />
                        <Run Foreground="Gray" Text="{Binding ChallengeRating, Mode=OneWay, StringFormat='CR {0}'}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Expander>

                <Separator DockPanel.Dock="Top" Margin="0,12" />

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <views:StatBlockDetailsView Margin="0,0,8,0" DataContext="{Binding StatBlockDetails}" />
                </ScrollViewer>
            </DockPanel>
        </Border>
        <!-- Turn order -->
        <DataGrid AllowDrop="True"
                  AutoGenerateColumns="False"
                  CanUserSortColumns="False"
                  HeadersVisibility="Column"
                  IsReadOnly="True"
                  ItemsSource="{Binding Combatants}"
                  PreviewDragOver="OnGridPreviewDragOver"
                  PreviewDrop="OnGridPreviewDrop"
                  PreviewMouseLeftButtonDown="OnGridPreviewMouseLeftButtonDown"
                  PreviewMouseMove="OnGridPreviewMouseMove"
                  SelectedItem="{Binding SelectedCombatant}"
                  SelectionMode="Single">
            <DataGrid.Resources>
                <!-- Applies to every TextBox inside the grid's cells. -->
                <Style TargetType="TextBox">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <EventSetter Event="KeyDown" Handler="OnCellTextBoxKeyDown" />
                </Style>
            </DataGrid.Resources>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                            <Setter Property="Background" Value="#FFF3D6" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="28" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Cursor="SizeAll"
                       Tag="DragHandle"
                       Text="≡"
                       TextAlignment="Center"
                       ToolTip="Drag to reorder" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Width="*"
                                    Binding="{Binding Name, Mode=OneWay}"
                                    Header="Name" />

                <DataGridTemplateColumn Width="90" Header="Initiative">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Initiative}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="110" Header="HP">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Click="OnHpButtonClick"
                    Content="{Binding HpText}"
                    IsEnabled="{Binding TracksHp}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="70" Header="Max HP">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding MaxHp, TargetNullValue=''}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="70" Header="AC">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding ArmorClass, TargetNullValue=''}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>