<UserControl x:Class="DnDInitiative.App.Views.EncounterBuilderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:DnDInitiative.App.Behaviors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:DnDInitiative.App.ViewModels"
             xmlns:views="clr-namespace:DnDInitiative.App.Views"
             d:DataContext="{d:DesignInstance Type=viewModels:EncounterBuilderViewModel}"
             d:DesignHeight="600"
             d:DesignWidth="1100"
             Loaded="OnLoaded"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!--  The two lists are as wide as the user dragged them; the gaps between hold the drag strips.  -->
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="Auto" />
            <!--  The drag strip and the stat block panel. Both take no room while the panel is hidden.  -->
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--  Left: saved encounters  -->
        <DockPanel Grid.Column="0" Width="{Binding EncounterListWidth.Value}">
            <TextBlock DockPanel.Dock="Top"
                       Style="{StaticResource PageTitle}"
                       Text="Encounters" />
            <DockPanel Margin="0,0,0,8" DockPanel.Dock="Top">
                <TextBlock Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"
                           Text="Sort by" />
                <ComboBox DisplayMemberPath="Label"
                          ItemsSource="{Binding SortOptions}"
                          SelectedItem="{Binding SelectedSort}" />
            </DockPanel>
            <StackPanel Margin="0,8,0,0"
                        DockPanel.Dock="Bottom"
                        Orientation="Horizontal">
                <Button Padding="12,4"
                        Command="{Binding NewEncounterCommand}"
                        Content="New" />
                <Button Margin="8,0,0,0"
                        Padding="12,4"
                        Command="{Binding CopyCommand}"
                        Content="Copy"
                        ToolTip="Make a copy of the selected encounter" />
                <Button Margin="8,0,0,0"
                        Padding="12,4"
                        Command="{Binding DeleteCommand}"
                        Content="Delete" />
            </StackPanel>
            <ListBox DisplayMemberPath="Name"
                     ItemsSource="{Binding Encounters}"
                     SelectedItem="{Binding SelectedEncounter}" />
        </DockPanel>

        <!--  Middle: the selected encounter  -->
        <DockPanel Grid.Column="2" Visibility="{Binding HasSelectedEncounter, Converter={StaticResource BoolToVisibility}}">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Encounter name" />
                <TextBox Margin="0,4,0,12" Text="{Binding SelectedEncounter.Name, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Creatures" />
            </StackPanel>

            <StackPanel Margin="0,12,0,0" DockPanel.Dock="Bottom">
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="Party" />
                    <ComboBox Width="180"
                              Margin="8,0,0,0"
                              DisplayMemberPath="Name"
                              ItemsSource="{Binding Parties}"
                              SelectedItem="{Binding SelectedParty}" />
                </StackPanel>

                <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding TotalXp, StringFormat='Total: {0:N0} XP'}" />
                    <TextBlock Margin="16,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource SectionTitle}"
                               Text="{Binding DifficultyText}" />
                    <ToggleButton x:Name="XpRangesButton"
                                  Margin="8,0,0,0"
                                  Padding="8,0"
                                  VerticalAlignment="Center"
                                  Content="?"
                                  ToolTip="XP ranges at every level for the selected party">
                        <ToggleButton.Style>
                            <Style BasedOn="{StaticResource {x:Type ToggleButton}}" TargetType="ToggleButton">
                                <Style.Triggers>
                                    <!--
                                        While the popup is open, a click on the button only closes it. Without this
                                        the same click would close the popup and then open it again.
                                    -->
                                    <DataTrigger Binding="{Binding IsOpen, ElementName=XpRangesPopup}" Value="True">
                                        <Setter Property="IsHitTestVisible" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <Popup x:Name="XpRangesPopup"
                           IsOpen="{Binding IsChecked, ElementName=XpRangesButton}"
                           Placement="Bottom"
                           PlacementTarget="{Binding ElementName=XpRangesButton}"
                           StaysOpen="False">
                        <Border Padding="12"
                                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <StackPanel Grid.IsSharedSizeScope="True">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="XP ranges by level" />
                                <TextBlock MaxWidth="420"
                                           Margin="0,4,0,8"
                                           HorizontalAlignment="Left"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding LevelXpRangesCaption}"
                                           TextWrapping="Wrap" />
                                <Grid Margin="6,0,6,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition SharedSizeGroup="XpLevel" />
                                        <ColumnDefinition SharedSizeGroup="XpLow" />
                                        <ColumnDefinition SharedSizeGroup="XpModerate" />
                                        <ColumnDefinition SharedSizeGroup="XpHigh" />
                                        <ColumnDefinition SharedSizeGroup="XpAboveHigh" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               FontWeight="SemiBold"
                                               Text="Level" />
                                    <TextBlock Grid.Column="1"
                                               Margin="16,0,0,0"
                                               FontWeight="SemiBold"
                                               Text="Low" />
                                    <TextBlock Grid.Column="2"
                                               Margin="16,0,0,0"
                                               FontWeight="SemiBold"
                                               Text="Moderate" />
                                    <TextBlock Grid.Column="3"
                                               Margin="16,0,0,0"
                                               FontWeight="SemiBold"
                                               Text="High" />
                                    <TextBlock Grid.Column="4"
                                               Margin="16,0,0,0"
                                               FontWeight="SemiBold"
                                               Text="Above High" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding LevelXpRanges}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type viewModels:LevelXpRangesViewModel}">
                                            <Border Padding="6,2" CornerRadius="3">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <!--  The levels the party's characters are at.  -->
                                                            <DataTrigger Binding="{Binding IsPartyLevel}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition SharedSizeGroup="XpLevel" />
                                                        <ColumnDefinition SharedSizeGroup="XpLow" />
                                                        <ColumnDefinition SharedSizeGroup="XpModerate" />
                                                        <ColumnDefinition SharedSizeGroup="XpHigh" />
                                                        <ColumnDefinition SharedSizeGroup="XpAboveHigh" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Level}" />
                                                    <TextBlock Grid.Column="1"
                                                               Margin="16,0,0,0"
                                                               Text="{Binding Low}" />
                                                    <TextBlock Grid.Column="2"
                                                               Margin="16,0,0,0"
                                                               Text="{Binding Moderate}" />
                                                    <TextBlock Grid.Column="3"
                                                               Margin="16,0,0,0"
                                                               Text="{Binding High}" />
                                                    <TextBlock Grid.Column="4"
                                                               Margin="16,0,0,0"
                                                               Text="{Binding AboveHigh}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>

                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                    <TextBlock Text="{Binding Budget.Low, StringFormat='Low: up to {0:N0}'}" />
                    <TextBlock Margin="16,0,0,0" Text="{Binding Budget.Moderate, StringFormat='Moderate: up to {0:N0}'}" />
                    <TextBlock Margin="16,0,0,0" Text="{Binding Budget.High, StringFormat='High: up to {0:N0}'}" />
                </StackPanel>

                <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                    <Button Padding="24,4"
                            Command="{Binding SaveCommand}"
                            Content="Save" />
                    <Button Margin="8,0,0,0"
                            Padding="24,4"
                            Command="{Binding StartEncounterCommand}"
                            Content="Start encounter" />
                    <Button Margin="8,0,0,0"
                            Padding="12,4"
                            Command="{Binding CopyLinkCommand}"
                            Content="Copy link" />
                    <TextBlock Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Text="{Binding StatusMessage}" />
                </StackPanel>
            </StackPanel>

            <DataGrid Margin="0,4,0,0"
                      behaviors:ClearSelectionOnEmptyClick.IsEnabled="True"
                      AutoGenerateColumns="False"
                      CanUserSortColumns="False"
                      HeadersVisibility="Column"
                      IsReadOnly="True"
                      ItemsSource="{Binding SelectedEncounter.Creatures}"
                      SelectedItem="{Binding SelectedCreature}"
                      SelectionMode="Single">
                <DataGrid.Resources>
                    <Style BasedOn="{StaticResource {x:Type TextBox}}" TargetType="TextBox">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Width="*"
                                        Binding="{Binding StatBlockName, Mode=OneWay}"
                                        Header="Creature" />
                    <DataGridTextColumn Width="50"
                                        Binding="{Binding ChallengeRating, Mode=OneWay}"
                                        Header="CR" />
                    <DataGridTextColumn Width="70"
                                        Binding="{Binding XpEach, Mode=OneWay, StringFormat=N0}"
                                        Header="XP each" />
                    <DataGridTemplateColumn Width="60" Header="Count">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="160" Header="Custom name">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding CustomName, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Padding="8,0"
                                        Command="{Binding DataContext.RemoveCreatureCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Content="Remove" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!--  Drag strips in the gaps on either side of the encounter  -->
        <Thumb Grid.Column="1"
               behaviors:ResizeHandle.PanelWidth="{Binding EncounterListWidth}"
               Style="{StaticResource ColumnResizeHandle}" />
        <Thumb Grid.Column="3"
               behaviors:ResizeHandle.GrowsLeft="True"
               behaviors:ResizeHandle.PanelWidth="{Binding LibraryWidth}"
               Style="{StaticResource ColumnResizeHandle}" />

        <!--  Right: stat block library  -->
        <DockPanel Grid.Column="4" Width="{Binding LibraryWidth.Value}">
            <TextBlock Margin="0,0,0,12"
                       DockPanel.Dock="Top"
                       Style="{StaticResource SectionTitle}"
                       Text="Stat blocks" />
            <TextBox Margin="0,0,0,8"
                     DockPanel.Dock="Top"
                     Text="{Binding StatBlockSearchText, UpdateSourceTrigger=PropertyChanged}" />
            <!--  Docked first, so it sits at the very bottom, under the button  -->
            <CheckBox Margin="0,8,0,0"
                      Content="Stat block panel"
                      DockPanel.Dock="Bottom"
                      IsChecked="{Binding ShowStatBlockPanel}"
                      ToolTip="Show the stat block of the creature you click, here or in the encounter" />
            <Button Margin="0,8,0,0"
                    Padding="12,4"
                    Command="{Binding AddCreatureCommand}"
                    Content="Add to encounter"
                    DockPanel.Dock="Bottom" />
            <ListBox behaviors:LoadMoreOnScroll.Command="{Binding LoadMoreStatBlocksCommand}"
                     ItemTemplate="{StaticResource StatBlockSummaryTemplate}"
                     ItemsSource="{Binding FilteredStatBlocks}"
                     SelectedItem="{Binding SelectedStatBlock}"
                     TextSearch.TextPath="Name" />
        </DockPanel>

        <!--  Drag strip between the library and the panel  -->
        <Thumb Grid.Column="5"
               Width="12"
               Cursor="SizeWE"
               DragCompleted="OnPanelResizeDragCompleted"
               DragDelta="OnPanelResizeDragDelta"
               ToolTip="Drag to resize"
               Visibility="{Binding ShowStatBlockPanel, Converter={StaticResource BoolToVisibility}}">
            <Thumb.Template>
                <ControlTemplate>
                    <!--  Transparent, but still catches the mouse  -->
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>

        <!--  Far right: the stat block of whatever was clicked last  -->
        <Border Grid.Column="6"
                Width="{Binding StatBlockPanelWidth}"
                Style="{StaticResource PanelBorder}"
                Visibility="{Binding ShowStatBlockPanel, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <views:StatBlockDetailsView Margin="0,0,8,0" DataContext="{Binding StatBlockDetails}" />
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>