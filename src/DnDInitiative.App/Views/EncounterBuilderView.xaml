<UserControl x:Class="DnDInitiative.App.Views.EncounterBuilderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:DnDInitiative.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:EncounterBuilderViewModel}"
             d:DesignWidth="1100"
             d:DesignHeight="600"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="260" />
        </Grid.ColumnDefinitions>

        <!-- Left: saved encounters -->
        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top"
                       Margin="0,0,0,12"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Text="Encounters" />
            <StackPanel DockPanel.Dock="Bottom"
                        Margin="0,8,0,0"
                        Orientation="Horizontal">
                <Button Padding="12,4"
                        Command="{Binding NewEncounterCommand}"
                        Content="New" />
                <Button Margin="8,0,0,0"
                        Padding="12,4"
                        Command="{Binding DeleteCommand}"
                        Content="Delete" />
            </StackPanel>
            <ListBox DisplayMemberPath="Name"
                     ItemsSource="{Binding Encounters}"
                     SelectedItem="{Binding SelectedEncounter}" />
        </DockPanel>

        <!-- Middle: the selected encounter -->
        <DockPanel Grid.Column="2" Visibility="{Binding HasSelectedEncounter, Converter={StaticResource BoolToVisibility}}">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Encounter name" />
                <TextBox Margin="0,4,0,12" Text="{Binding SelectedEncounter.Name, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Creatures" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="Party" />
                    <ComboBox Width="180"
                              Margin="8,0,0,0"
                              DisplayMemberPath="Name"
                              ItemsSource="{Binding Parties}"
                              SelectedItem="{Binding SelectedParty}" />
                </StackPanel>

                <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                    <TextBlock FontSize="18"
                               FontWeight="SemiBold"
                               Text="{Binding TotalXp, StringFormat='Total: {0:N0} XP'}" />
                    <TextBlock Margin="16,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="18"
                               Text="{Binding DifficultyText}" />
                </StackPanel>

                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                    <TextBlock Text="{Binding Budget.Low, StringFormat='Low: up to {0:N0}'}" />
                    <TextBlock Margin="16,0,0,0" Text="{Binding Budget.Moderate, StringFormat='Moderate: up to {0:N0}'}" />
                    <TextBlock Margin="16,0,0,0" Text="{Binding Budget.High, StringFormat='High: up to {0:N0}'}" />
                </StackPanel>

                <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                    <Button Padding="24,4"
                            Command="{Binding SaveCommand}"
                            Content="Save" />
                    <Button Margin="8,0,0,0"
                            Padding="24,4"
                            Command="{Binding StartEncounterCommand}"
                            Content="Start encounter" />
                    <Button Margin="8,0,0,0"
                            Padding="12,4"
                            Command="{Binding CopyLinkCommand}"
                            Content="Copy link" />
                    <TextBlock Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Text="{Binding StatusMessage}" />
                </StackPanel>
            </StackPanel>

            <DataGrid Margin="0,4,0,0"
                      AutoGenerateColumns="False"
                      CanUserSortColumns="False"
                      HeadersVisibility="Column"
                      IsReadOnly="True"
                      ItemsSource="{Binding SelectedEncounter.Creatures}"
                      SelectionMode="Single">
                <DataGrid.Resources>
                    <Style TargetType="TextBox">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Width="*"
                                        Binding="{Binding StatBlockName, Mode=OneWay}"
                                        Header="Creature" />
                    <DataGridTextColumn Width="50"
                                        Binding="{Binding ChallengeRating, Mode=OneWay}"
                                        Header="CR" />
                    <DataGridTextColumn Width="70"
                                        Binding="{Binding XpEach, Mode=OneWay, StringFormat=N0}"
                                        Header="XP each" />
                    <DataGridTemplateColumn Width="60" Header="Count">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="160" Header="Custom name">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding CustomName, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Padding="8,0"
                                        Command="{Binding DataContext.RemoveCreatureCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Content="Remove" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- Right: stat block library -->
        <DockPanel Grid.Column="4">
            <TextBlock DockPanel.Dock="Top"
                       Margin="0,0,0,12"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Text="Stat blocks" />
            <TextBox DockPanel.Dock="Top"
                     Margin="0,0,0,8"
                     Text="{Binding StatBlockSearchText, UpdateSourceTrigger=PropertyChanged}" />
            <Button DockPanel.Dock="Bottom"
                    Margin="0,8,0,0"
                    Padding="12,4"
                    Command="{Binding AddCreatureCommand}"
                    Content="Add to encounter" />
            <ListBox ItemsSource="{Binding FilteredStatBlocks}" SelectedItem="{Binding SelectedStatBlock}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <Run Text="{Binding Name, Mode=OneWay}" />
                            <Run Foreground="Gray" Text="{Binding ChallengeRating, Mode=OneWay, StringFormat='CR {0}'}" />
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Grid>
</UserControl>