<Window x:Class="DnDInitiative.App.Views.UnsavedChangesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        MinWidth="360"
        MaxWidth="560"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner">
    <!--
        A message box cannot rename its buttons, and "Yes / No / Cancel" does not say which of
        them saves. This small window can.
    -->
    <StackPanel Margin="24">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        <StackPanel Margin="0,24,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <!--  Enter saves, the choice that loses nothing. Escape cancels, which changes nothing.  -->
            <Button MinWidth="96"
                    Click="OnSaveClick"
                    Content="_Save"
                    IsDefault="True" />
            <Button MinWidth="96"
                    Margin="8,0,0,0"
                    Click="OnDiscardClick"
                    Content="_Don't save" />
            <Button MinWidth="96"
                    Margin="8,0,0,0"
                    Content="Cancel"
                    IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
