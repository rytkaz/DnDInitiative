<UserControl x:Class="DnDInitiative.App.Views.SpellbookView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:DnDInitiative.App.Behaviors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:DnDInitiative.App.ViewModels"
             xmlns:views="clr-namespace:DnDInitiative.App.Views"
             d:DataContext="{d:DesignInstance Type=viewModels:SpellbookViewModel}"
             d:DesignHeight="700"
             d:DesignWidth="1300"
             Loaded="OnLoaded"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!--
            The library's columns. The heading row and every row use these widths, so they line up;
            the name takes what is left. LibraryHeader's right margin follows the list's scroll bar.
        -->
        <GridLength x:Key="AddedColumnWidth">22</GridLength>
        <GridLength x:Key="LevelColumnWidth">46</GridLength>
        <GridLength x:Key="TimeColumnWidth">58</GridLength>
        <GridLength x:Key="RangeColumnWidth">70</GridLength>
        <GridLength x:Key="MarkColumnWidth">24</GridLength>

        <!--  A column's heading: flat, and a button, because clicking it sorts by the column  -->
        <DataTemplate DataType="{x:Type viewModels:LibraryColumnHeader}">
            <Button MinWidth="0"
                    MinHeight="0"
                    Padding="2,3"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding SortCommand}"
                    ToolTip="{Binding ToolTip}">
                <TextBlock FontSize="11" FontWeight="SemiBold">
                    <Run Text="{Binding Label, Mode=OneWay}" /><Run Text="{Binding Arrow, Mode=OneWay}" />
                </TextBlock>
            </Button>
        </DataTemplate>

        <!--  The form for the entry being written, by kind  -->
        <DataTemplate DataType="{x:Type viewModels:SpellEditorViewModel}">
            <views:SpellEditorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:AbilityEditorViewModel}">
            <views:AbilityEditorView />
        </DataTemplate>

        <!--  A cell's text in a row of the library  -->
        <Style x:Key="LibraryCell" TargetType="TextBlock">
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!--  The two side panels are as wide as the user dragged them; the gaps between hold the drag strips.  -->
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--  Left: saved spellbooks  -->
        <DockPanel Grid.Column="0" Width="{Binding SpellbookListWidth.Value}">
            <TextBlock DockPanel.Dock="Top"
                       Style="{StaticResource PageTitle}"
                       Text="Spellbooks" />
            <StackPanel Margin="0,8,0,0"
                        DockPanel.Dock="Bottom"
                        Orientation="Horizontal">
                <Button Padding="12,4"
                        Command="{Binding NewSpellbookCommand}"
                        Content="New" />
                <Button Margin="8,0,0,0"
                        Padding="12,4"
                        Command="{Binding CopyCommand}"
                        Content="Copy"
                        ToolTip="Make a copy of the selected spellbook" />
                <Button Margin="8,0,0,0"
                        Padding="12,4"
                        Command="{Binding DeleteCommand}"
                        Content="Delete" />
            </StackPanel>
            <ListBox DisplayMemberPath="Name"
                     ItemsSource="{Binding Spellbooks}"
                     SelectedItem="{Binding SelectedSpellbook}" />
        </DockPanel>

        <Thumb Grid.Column="1"
               behaviors:ResizeHandle.PanelWidth="{Binding SpellbookListWidth}"
               Style="{StaticResource ColumnResizeHandle}" />

        <!--  Middle: the open spellbook's pages  -->
        <DockPanel Grid.Column="2" Visibility="{Binding ShowPages, Converter={StaticResource BoolToVisibility}}">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Spellbook name" />
                <TextBox Margin="0,4,0,12" Text="{Binding SelectedSpellbook.Name, UpdateSourceTrigger=PropertyChanged}" />

                <DockPanel Margin="0,0,0,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   Text="Zoom" />
                        <ComboBox Width="90"
                                  DisplayMemberPath="Label"
                                  ItemsSource="{Binding ZoomOptions}"
                                  SelectedItem="{Binding SelectedZoom}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Padding="24,4"
                                Command="{Binding SaveCommand}"
                                Content="Save" />
                        <Button Margin="8,0,0,0"
                                Padding="12,4"
                                Command="{Binding PrintCommand}"
                                Content="Print..."
                                ToolTip="Preview the pages, then print them at 100%. Choose Microsoft Print to PDF for a PDF." />
                        <Button Margin="8,0,0,0"
                                Padding="12,4"
                                Command="{Binding SortPagesCommand}"
                                Content="Sort pages"
                                ToolTip="Put the cards in the library's sort order. Dragging a card changes the order again." />
                        <TextBlock Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding StatusMessage}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>

                <TextBlock Margin="0,0,0,8"
                           Style="{StaticResource SecondaryText}"
                           Text="{Binding Summary}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!--
                Focusable, so Delete reaches it after a card is clicked. Cards are dragged to change
                their order, and library rows are dropped here to add them.
            -->
            <ScrollViewer x:Name="PagesScroller"
                          AllowDrop="True"
                          Background="{DynamicResource ControlFillColorSecondaryBrush}"
                          DragLeave="OnPagesDragLeave"
                          DragOver="OnPagesDragOver"
                          Drop="OnPagesDrop"
                          FocusVisualStyle="{x:Null}"
                          Focusable="True"
                          HorizontalScrollBarVisibility="Auto"
                          PreviewMouseLeftButtonDown="OnPagesPreviewMouseLeftButtonDown"
                          PreviewMouseMove="OnPagesPreviewMouseMove"
                          VerticalScrollBarVisibility="Auto">
                <ScrollViewer.InputBindings>
                    <KeyBinding Key="Delete" Command="{Binding RemoveSelectedCardCommand}" />
                </ScrollViewer.InputBindings>
                <ItemsControl Margin="16" ItemsSource="{Binding Pages}">
                    <ItemsControl.LayoutTransform>
                        <ScaleTransform ScaleX="{Binding SelectedZoom.Scale}" ScaleY="{Binding SelectedZoom.Scale}" />
                    </ItemsControl.LayoutTransform>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:SpellbookPageViewModel}">
                            <StackPanel Margin="0,0,0,24" HorizontalAlignment="Center">
                                <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                    <views:SpellbookSheetView />
                                </Border>
                                <TextBlock Margin="0,6,0,0"
                                           HorizontalAlignment="Center"
                                           FontSize="16"
                                           Style="{StaticResource SecondaryText}"
                                           Text="{Binding Number, StringFormat='Page {0}'}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <!--  Middle, instead of the pages while a spell or ability is being written: the form, and the card it makes  -->
        <Grid Grid.Column="2" Visibility="{Binding HasEditor, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Width="{Binding EditorFormWidth.Value}">
                <TextBlock DockPanel.Dock="Top"
                           Style="{StaticResource PageTitle}"
                           Text="{Binding Editor.Heading}" />
                <TextBlock Margin="0,0,0,8"
                           DockPanel.Dock="Top"
                           Style="{StaticResource SecondaryText}"
                           Text="{Binding Editor.Note}"
                           TextWrapping="Wrap" />
                <StackPanel Margin="0,0,0,12"
                            DockPanel.Dock="Top"
                            Orientation="Horizontal">
                    <Button Padding="24,4"
                            Command="{Binding SaveEditorCommand}"
                            Content="Save"
                            IsEnabled="{Binding Editor.CanSave}" />
                    <Button Margin="8,0,0,0"
                            Padding="12,4"
                            Command="{Binding CloseEditorCommand}"
                            Content="Close" />
                    <TextBlock Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Text="{Binding StatusMessage}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ContentControl Margin="0,0,12,0" Content="{Binding Editor}" />
                </ScrollViewer>
            </DockPanel>

            <Thumb Grid.Column="1"
                   behaviors:ResizeHandle.PanelWidth="{Binding EditorFormWidth}"
                   Style="{StaticResource ColumnResizeHandle}" />

            <ScrollViewer Grid.Column="2"
                          Background="{DynamicResource ControlFillColorSecondaryBrush}"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl Margin="16"
                              HorizontalAlignment="Center"
                              ItemsSource="{Binding Editor.PreviewCards}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:CardView Margin="0,0,0,12" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Thumb Grid.Column="3"
               behaviors:ResizeHandle.GrowsLeft="True"
               behaviors:ResizeHandle.PanelWidth="{Binding LibraryWidth}"
               Style="{StaticResource ColumnResizeHandle}" />

        <!--  Right: the spell and ability library, with a preview of the row clicked last  -->
        <DockPanel Grid.Column="4" Width="{Binding LibraryWidth.Value}">
            <TextBlock Margin="0,0,0,12"
                       DockPanel.Dock="Top"
                       Style="{StaticResource SectionTitle}"
                       Text="Library" />

            <!--  Writing and changing entries; double-clicking a row still adds it to the spellbook  -->
            <WrapPanel Margin="0,0,0,8" DockPanel.Dock="Top">
                <Button Margin="0,0,8,4"
                        Padding="10,4"
                        Command="{Binding NewSpellCommand}"
                        Content="New spell" />
                <Button Margin="0,0,8,4"
                        Padding="10,4"
                        Command="{Binding NewAbilityCommand}"
                        Content="New ability" />
                <Button Margin="0,0,8,4"
                        Padding="10,4"
                        Command="{Binding EditEntryCommand}"
                        Content="Edit"
                        ToolTip="Change the selected spell or ability. An imported one is saved as your own copy." />
                <Button Margin="0,0,8,4"
                        Padding="10,4"
                        Command="{Binding DuplicateEntryCommand}"
                        Content="Duplicate"
                        ToolTip="Start a new homebrew entry from the selected one" />
                <Button Margin="0,0,8,4"
                        Padding="10,4"
                        Command="{Binding RemoveCustomCommand}"
                        Content="{Binding RemoveLabel}"
                        ToolTip="Delete an entry you wrote, or revert one you changed to the imported version" />
            </WrapPanel>
            <TextBox Margin="0,0,0,8"
                     DockPanel.Dock="Top"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Search by name" />

            <Grid Margin="0,0,0,8" DockPanel.Dock="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ComboBox Grid.Row="0"
                          Grid.Column="0"
                          DisplayMemberPath="Label"
                          ItemsSource="{Binding KindOptions}"
                          SelectedItem="{Binding SelectedKind}" />
                <ComboBox Grid.Row="0"
                          Grid.Column="2"
                          DisplayMemberPath="Label"
                          ItemsSource="{Binding ClassOptions}"
                          SelectedItem="{Binding SelectedClass}"
                          ToolTip="Only spells and abilities this class can learn" />
                <ComboBox Grid.Row="2"
                          Grid.Column="0"
                          DisplayMemberPath="Label"
                          ItemsSource="{Binding LevelOptions}"
                          SelectedItem="{Binding SelectedLevel}"
                          ToolTip="A spell's level, or an exploit's degree" />
                <ComboBox Grid.Row="2"
                          Grid.Column="2"
                          DisplayMemberPath="Label"
                          ItemsSource="{Binding ConcentrationOptions}"
                          SelectedItem="{Binding SelectedConcentration}" />
                <CheckBox Grid.Row="4"
                          Grid.Column="0"
                          VerticalAlignment="Center"
                          Content="Rituals only"
                          IsChecked="{Binding RitualsOnly}" />
            </Grid>

            <TextBlock Margin="0,0,0,8"
                       DockPanel.Dock="Top"
                       Text="{Binding LibraryHint}"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style BasedOn="{StaticResource SecondaryText}" TargetType="TextBlock">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!--  The preview, docked first so it sits at the bottom, with its drag strip above it  -->
            <ScrollViewer Height="{Binding PreviewHeight.Value}"
                          DockPanel.Dock="Bottom"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl HorizontalAlignment="Center" ItemsSource="{Binding PreviewCards}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:CardView Margin="0,0,0,8" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Thumb Height="12"
                   behaviors:ResizeHandle.GrowsUp="True"
                   behaviors:ResizeHandle.PanelHeight="{Binding PreviewHeight}"
                   DockPanel.Dock="Bottom"
                   Style="{StaticResource RowResizeHandle}" />

            <!--  The column headings, which sort the list when clicked, and a line under them  -->
            <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1"
                    DockPanel.Dock="Top">
                <Grid x:Name="LibraryHeader" Margin="8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource AddedColumnWidth}" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{StaticResource LevelColumnWidth}" />
                        <ColumnDefinition Width="{StaticResource TimeColumnWidth}" />
                        <ColumnDefinition Width="{StaticResource RangeColumnWidth}" />
                        <ColumnDefinition Width="{StaticResource MarkColumnWidth}" />
                        <ColumnDefinition Width="{StaticResource MarkColumnWidth}" />
                    </Grid.ColumnDefinitions>
                    <ContentControl Grid.Column="1" Content="{Binding NameColumn}" />
                    <ContentControl Grid.Column="2" Content="{Binding LevelColumn}" />
                    <ContentControl Grid.Column="3" Content="{Binding CastingTimeColumn}" />
                    <ContentControl Grid.Column="4" Content="{Binding RangeColumn}" />
                    <ContentControl Grid.Column="5" Content="{Binding RitualColumn}" />
                    <ContentControl Grid.Column="6" Content="{Binding ConcentrationColumn}" />
                </Grid>
            </Border>

            <ListBox x:Name="LibraryList"
                     ItemsSource="{Binding Library}"
                     Loaded="OnLibraryListLoaded"
                     MouseDoubleClick="OnLibraryDoubleClick"
                     PreviewMouseLeftButtonDown="OnLibraryPreviewMouseLeftButtonDown"
                     PreviewMouseMove="OnLibraryPreviewMouseMove"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectedItem="{Binding SelectedLibraryEntry}"
                     TextSearch.TextPath="Name"
                     VirtualizingPanel.IsVirtualizing="True">
                <!--  Short rows, closer together than the theme's, so the list reads as a table  -->
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Command="{Binding EditEntryCommand}" Header="Edit" />
                        <MenuItem Command="{Binding DuplicateEntryCommand}" Header="Duplicate" />
                        <MenuItem Command="{Binding RemoveCustomCommand}" Header="{Binding RemoveLabel}" />
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemContainerStyle>
                    <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Padding" Value="8,0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type viewModels:LibraryEntryViewModel}">
                        <!--  A thin line under every row  -->
                        <Border Padding="0,4"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1"
                                ToolTip="{Binding ToolTip}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource AddedColumnWidth}" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{StaticResource LevelColumnWidth}" />
                                    <ColumnDefinition Width="{StaticResource TimeColumnWidth}" />
                                    <ColumnDefinition Width="{StaticResource RangeColumnWidth}" />
                                    <ColumnDefinition Width="{StaticResource MarkColumnWidth}" />
                                    <ColumnDefinition Width="{StaticResource MarkColumnWidth}" />
                                </Grid.ColumnDefinitions>
                                <!--  "+" adds the row to the open spellbook; once added it shows "✓", which removes it again  -->
                                <Button x:Name="InSpellbookToggle"
                                        Grid.Column="0"
                                        MinWidth="0"
                                        MinHeight="0"
                                        Margin="0,0,4,0"
                                        Padding="0"
                                        HorizontalAlignment="Stretch"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding DataContext.ToggleInSpellbookCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Add to the open spellbook (or double-click the row, or drag it onto the pages)">
                                    <TextBlock x:Name="InSpellbookMark"
                                               FontSize="12"
                                               Style="{StaticResource SecondaryText}"
                                               Text="+" />
                                </Button>
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource LibraryCell}"
                                           Text="{Binding Name}" />
                                <TextBlock Grid.Column="2"
                                           Style="{StaticResource LibraryCell}"
                                           Text="{Binding LevelLabel}" />
                                <TextBlock Grid.Column="3"
                                           Style="{StaticResource LibraryCell}"
                                           Text="{Binding ShortCastingTime}" />
                                <TextBlock Grid.Column="4"
                                           Style="{StaticResource LibraryCell}"
                                           Text="{Binding ShortRange}" />
                                <TextBlock Grid.Column="5"
                                           FontWeight="SemiBold"
                                           Style="{StaticResource LibraryCell}"
                                           Text="{Binding RitualMark}" />
                                <TextBlock Grid.Column="6"
                                           FontWeight="SemiBold"
                                           Style="{StaticResource LibraryCell}"
                                           Text="{Binding ConcentrationMark}" />
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsInSpellbook}" Value="True">
                                <Setter TargetName="InSpellbookMark" Property="Text" Value="✓" />
                                <Setter TargetName="InSpellbookMark" Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="InSpellbookToggle" Property="ToolTip" Value="In the open spellbook. Click to remove it." />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Grid>
</UserControl>