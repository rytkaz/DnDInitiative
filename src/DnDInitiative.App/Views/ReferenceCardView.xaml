<UserControl x:Class="DnDInitiative.App.Views.ReferenceCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:formatting="clr-namespace:DnDInitiative.App.Formatting"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:DnDInitiative.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewModels:SpellDetailsViewModel}"
             d:DesignHeight="500"
             d:DesignWidth="460"
             mc:Ignorable="d">
    <!--
        A spell or a condition, on the same printed card as a stat block. The data context is an
        IReferenceCard. The colours and the rule come from Styles/AppStyles.xaml.
    -->
    <Border Background="{StaticResource StatBlockPaper}"
            BorderBrush="{StaticResource StatBlockEdge}"
            BorderThickness="0,5"
            TextElement.Foreground="{StaticResource StatBlockInk}">
        <!--  Inside the border, so the coloured edges stay put while a long spell scrolls  -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="14,10">
                <formatting:MarkdownTextBox FontFamily="Georgia"
                                            FontSize="24"
                                            FontWeight="Bold"
                                            Foreground="{StaticResource StatBlockAccent}"
                                            Label="{Binding Name}"
                                            Typography.Capitals="SmallCaps" />
                <formatting:MarkdownTextBox FontStyle="Italic" Label="{Binding Summary}" />

                <Polygon Style="{StaticResource TaperedRule}" />

                <!--  "Casting Time 1 action": the label in bold red  -->
                <ItemsControl ItemsSource="{Binding Stats}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <formatting:MarkdownTextBox Margin="0,2"
                                                        Label="{Binding Label}"
                                                        LabelStyle="{StaticResource CardStatLabel}"
                                                        Markdown="{Binding Value}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Polygon Style="{StaticResource TaperedRule}" />

                <!--  The rules text, one block at a time  -->
                <ItemsControl ItemsSource="{Binding Blocks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel x:Name="Row" Margin="0,4">
                                <!--  Only shown for list items; see the trigger below  -->
                                <TextBlock x:Name="BulletMark"
                                           Margin="8,0,8,0"
                                           DockPanel.Dock="Left"
                                           Text="•"
                                           Visibility="Collapsed" />
                                <formatting:MarkdownTextBox x:Name="BlockText" Markdown="{Binding Text}" />
                            </DockPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="Heading">
                                    <Setter TargetName="Row" Property="Margin" Value="0,10,0,2" />
                                    <Setter TargetName="BlockText" Property="FontFamily" Value="Georgia" />
                                    <Setter TargetName="BlockText" Property="FontSize" Value="17" />
                                    <Setter TargetName="BlockText" Property="Foreground" Value="{StaticResource StatBlockAccent}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Bullet">
                                    <Setter TargetName="Row" Property="Margin" Value="0,2" />
                                    <Setter TargetName="BulletMark" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
