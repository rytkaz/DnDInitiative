<Window x:Class="DnDInitiative.App.Views.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:DnDInitiative.App.ViewModels"
        xmlns:views="clr-namespace:DnDInitiative.App.Views"
        Title="{Binding Title}"
        Width="1000"
        Height="760"
        MinWidth="600"
        MinHeight="400"
        WindowStartupLocation="CenterOwner">
    <!--  One window for every import. The data template picks the view for the import it was opened for.  -->
    <ContentControl Margin="24" Content="{Binding}">
        <ContentControl.Resources>
            <DataTemplate DataType="{x:Type viewModels:ImportViewModel}">
                <views:ImportView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:HomebreweryImportViewModel}">
                <views:HomebreweryImportView />
            </DataTemplate>
        </ContentControl.Resources>
    </ContentControl>
</Window>
