<UserControl x:Class="DnDInitiative.App.Views.ImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:DnDInitiative.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewModels:ImportViewModel}"
             d:DesignHeight="600"
             d:DesignWidth="900"
             Loaded="OnLoaded"
             mc:Ignorable="d">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top"
                   Style="{StaticResource PageTitle}"
                   Text="{Binding Title}" />
        <TextBlock Margin="0,0,0,12"
                   DockPanel.Dock="Top"
                   Text="Runs ttrpg-convert on your 5eTools data, then imports every stat block from the notes it writes."
                   TextWrapping="Wrap" />

        <!--  The four paths. Disabled as a group while a run is in progress.  -->
        <Grid DockPanel.Dock="Top" IsEnabled="{Binding IsIdle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       VerticalAlignment="Center"
                       Text="ttrpg-convert program (optional)" />
            <TextBox Grid.Row="0"
                     Grid.Column="1"
                     Margin="12,4"
                     Text="{Binding ToolPath, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Row="0"
                    Grid.Column="2"
                    Margin="0,4"
                    Padding="12,4"
                    Command="{Binding BrowseToolCommand}"
                    Content="Browse..." />

            <TextBlock Grid.Row="1"
                       VerticalAlignment="Center"
                       Text="Configuration file (advanced)" />
            <TextBox Grid.Row="1"
                     Grid.Column="1"
                     Margin="12,4"
                     Text="{Binding ConfigPath, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Row="1"
                    Grid.Column="2"
                    Margin="0,4"
                    Padding="12,4"
                    Command="{Binding BrowseConfigCommand}"
                    Content="Browse..." />

            <TextBlock Grid.Row="2"
                       VerticalAlignment="Center"
                       Text="5eTools data folder" />
            <TextBox Grid.Row="2"
                     Grid.Column="1"
                     Margin="12,4"
                     Text="{Binding DataDirectory, UpdateSourceTrigger=PropertyChanged}" />
            <StackPanel Grid.Row="2"
                        Grid.Column="2"
                        Orientation="Horizontal">
                <Button Margin="0,4"
                        Padding="12,4"
                        Command="{Binding BrowseDataCommand}"
                        Content="Browse..." />
                <Button Margin="8,4,0,4"
                        Padding="12,4"
                        Command="{Binding UseDataZipCommand}"
                        Content="From zip..."
                        ToolTip="Unpack the data from a 5eTools zip file you downloaded" />
            </StackPanel>

            <TextBlock Grid.Row="3"
                       VerticalAlignment="Center"
                       Text="Output folder" />
            <TextBox Grid.Row="3"
                     Grid.Column="1"
                     Margin="12,4"
                     Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Row="3"
                    Grid.Column="2"
                    Margin="0,4"
                    Padding="12,4"
                    Command="{Binding BrowseOutputCommand}"
                    Content="Browse..." />
        </Grid>

        <TextBlock Margin="0,4,0,0"
                   DockPanel.Dock="Top"
                   Style="{StaticResource SecondaryText}"
                   Text="Leave the program empty to use the app's own copy of the converter. Leave the configuration empty to import the books ticked below; a configuration file of your own replaces that list."
                   TextWrapping="Wrap" />

        <!--  Which books to import. Filled from the chosen data folder.  -->
        <DockPanel Height="190"
                   Margin="0,12,0,0"
                   DockPanel.Dock="Top"
                   IsEnabled="{Binding IsIdle}">
            <DockPanel Margin="0,0,0,4" DockPanel.Dock="Top">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Padding="8,2"
                            Command="{Binding SelectAllSourcesCommand}"
                            Content="Select all" />
                    <Button Margin="8,0,0,0"
                            Padding="8,2"
                            Command="{Binding ClearSourcesCommand}"
                            Content="Clear" />
                </StackPanel>
                <TextBlock VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="Books to import" />
            </DockPanel>

            <Border Padding="8" Style="{StaticResource PanelBorder}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Sources}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!--  Flows into as many columns as fit the width.  -->
                                <WrapPanel ItemWidth="320" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </DockPanel>

        <StackPanel Margin="0,12,0,0"
                    DockPanel.Dock="Top"
                    Orientation="Horizontal">
            <Button Padding="12,4"
                    Command="{Binding RunCommand}"
                    Content="Convert and import" />
            <Button Margin="8,0,0,0"
                    Padding="12,4"
                    Command="{Binding RunCancelCommand}"
                    Content="Cancel" />
            <Button Margin="24,0,0,0"
                    Padding="12,4"
                    Command="{Binding UpdateConverterCommand}"
                    Content="Download latest converter"
                    ToolTip="Replace the app's copy of the converter with the newest release" />
        </StackPanel>

        <TextBlock Margin="0,12,0,8"
                   DockPanel.Dock="Top"
                   Text="{Binding StatusMessage}"
                   TextWrapping="Wrap" />

        <!--  The converter's own output. Fills whatever space is left.  -->
        <TextBox FontFamily="Consolas"
                 HorizontalScrollBarVisibility="Auto"
                 IsReadOnly="True"
                 Text="{Binding Log, Mode=OneWay}"
                 TextChanged="OnLogTextChanged"
                 VerticalScrollBarVisibility="Auto" />
    </DockPanel>
</UserControl>