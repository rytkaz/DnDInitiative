<UserControl x:Class="DnDInitiative.App.Views.ImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:DnDInitiative.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewModels:ImportViewModel}"
             d:DesignHeight="600"
             d:DesignWidth="900"
             Loaded="OnLoaded"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <DockPanel>
        <TextBlock DockPanel.Dock="Top"
                   Style="{StaticResource PageTitle}"
                   Text="{Binding Title}" />
        <TextBlock Margin="0,0,0,12"
                   DockPanel.Dock="Top"
                   Text="Runs ttrpg-convert on your 5eTools data and adds every stat block it produces to the library."
                   TextWrapping="Wrap" />

        <!--  The three paths. Disabled as a group while a run is in progress.  -->
        <Grid DockPanel.Dock="Top" IsEnabled="{Binding IsIdle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       VerticalAlignment="Center"
                       Text="ttrpg-convert program (optional)" />
            <TextBox Grid.Row="0"
                     Grid.Column="1"
                     Margin="12,4"
                     Text="{Binding ToolPath, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Row="0"
                    Grid.Column="2"
                    Margin="0,4"
                    Padding="12,4"
                    Command="{Binding BrowseToolCommand}"
                    Content="Browse..." />

            <TextBlock Grid.Row="1"
                       VerticalAlignment="Center"
                       Text="Configuration file (optional)" />
            <TextBox Grid.Row="1"
                     Grid.Column="1"
                     Margin="12,4"
                     Text="{Binding ConfigPath, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Row="1"
                    Grid.Column="2"
                    Margin="0,4"
                    Padding="12,4"
                    Command="{Binding BrowseConfigCommand}"
                    Content="Browse..." />

            <TextBlock Grid.Row="2"
                       VerticalAlignment="Center"
                       Text="5eTools data folder" />
            <TextBox Grid.Row="2"
                     Grid.Column="1"
                     Margin="12,4"
                     Text="{Binding DataDirectory, UpdateSourceTrigger=PropertyChanged}" />
            <StackPanel Grid.Row="2"
                        Grid.Column="2"
                        Orientation="Horizontal">
                <Button Margin="0,4"
                        Padding="12,4"
                        Command="{Binding BrowseDataCommand}"
                        Content="Browse..." />
                <Button Margin="8,4,0,4"
                        Padding="12,4"
                        Command="{Binding UseDataZipCommand}"
                        Content="From zip..."
                        ToolTip="Unpack the data from a 5eTools zip file you downloaded" />
            </StackPanel>
        </Grid>

        <TextBlock Margin="0,4,0,0"
                   DockPanel.Dock="Top"
                   Style="{StaticResource SecondaryText}"
                   Text="Leave the program empty to use the app's own copy of the converter. Leave the configuration empty to import the books ticked below and the homebrew files listed under them; a configuration file of your own replaces both."
                   TextWrapping="Wrap" />

        <!--  Which books to import. Filled from the chosen data folder.  -->
        <DockPanel Height="{Binding SourcesPanelHeight}"
                   Margin="0,12,0,0"
                   DockPanel.Dock="Top"
                   IsEnabled="{Binding IsIdle}">
            <DockPanel Margin="0,0,0,4" DockPanel.Dock="Top">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Padding="8,2"
                            Command="{Binding SelectAllSourcesCommand}"
                            Content="Select all" />
                    <Button Margin="8,0,0,0"
                            Padding="8,2"
                            Command="{Binding ClearSourcesCommand}"
                            Content="Clear" />
                </StackPanel>
                <TextBlock VerticalAlignment="Center"
                           DockPanel.Dock="Left"
                           FontWeight="SemiBold"
                           Text="Books to import" />
                <TextBlock Margin="24,0,8,0"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"
                           Text="Search" />
                <!--  Fills the space between the heading and the buttons  -->
                <TextBox Margin="0,0,12,0" Text="{Binding SourceSearchText, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>

            <Border Padding="8" Style="{StaticResource PanelBorder}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Sources}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!--  Flows into as many columns as fit the width.  -->
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <!--
                            The width and the hiding are set on the item's container, which is what the
                            WrapPanel lays out. A collapsed container takes no space, so the books that
                            match the search close up. The book is hidden, not removed: its tick is kept.
                        -->
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Width" Value="320" />
                                <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </DockPanel>

        <!--  Drag strip under the book list: pull it down to see more books  -->
        <Thumb Height="10"
               Cursor="SizeNS"
               DockPanel.Dock="Top"
               DragCompleted="OnSourcesResizeDragCompleted"
               DragDelta="OnSourcesResizeDragDelta"
               ToolTip="Drag to resize the book list">
            <Thumb.Template>
                <ControlTemplate>
                    <!--  Transparent, but still catches the mouse  -->
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>

        <!--  Homebrew books: one JSON file each, converted along with the ticked books  -->
        <DockPanel Margin="0,4,0,0"
                   DockPanel.Dock="Top"
                   IsEnabled="{Binding IsIdle}">
            <DockPanel Margin="0,0,0,4" DockPanel.Dock="Top">
                <Button Padding="8,2"
                        Command="{Binding AddHomebrewCommand}"
                        Content="Add file..."
                        DockPanel.Dock="Right" />
                <TextBlock VerticalAlignment="Center"
                           DockPanel.Dock="Left"
                           FontWeight="SemiBold"
                           Text="Homebrew files" />
                <TextBlock Margin="24,0,12,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource SecondaryText}"
                           Text="Books in 5eTools homebrew format (.json). Every monster in a listed file is imported."
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <ItemsControl x:Name="HomebrewList" ItemsSource="{Binding HomebrewFiles}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,2">
                            <!--
                                Inside the template the data context is one file, but the command lives
                                on the page's view model. The binding reaches it through the list,
                                and hands over this row's file as the parameter.
                            -->
                            <Button Padding="8,2"
                                    Command="{Binding DataContext.RemoveHomebrewCommand, ElementName=HomebrewList}"
                                    CommandParameter="{Binding}"
                                    Content="Remove"
                                    DockPanel.Dock="Right" />
                            <TextBlock Margin="0,0,12,0"
                                       VerticalAlignment="Center"
                                       Text="{Binding Label}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Path}" />
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>

        <StackPanel Margin="0,12,0,0"
                    DockPanel.Dock="Top"
                    Orientation="Horizontal">
            <Button Padding="12,4"
                    Command="{Binding RunCommand}"
                    Content="Convert and import" />
            <Button Margin="8,0,0,0"
                    Padding="12,4"
                    Command="{Binding RunCancelCommand}"
                    Content="Cancel" />
            <Button Margin="24,0,0,0"
                    Padding="12,4"
                    Command="{Binding UpdateConverterCommand}"
                    Content="Download latest converter"
                    ToolTip="Replace the app's copy of the converter with the newest release" />
        </StackPanel>

        <TextBlock Margin="0,12,0,8"
                   DockPanel.Dock="Top"
                   Text="{Binding StatusMessage}"
                   TextWrapping="Wrap" />

        <!--  The converter's own output. Fills whatever space is left.  -->
        <TextBox FontFamily="Consolas"
                 HorizontalScrollBarVisibility="Auto"
                 IsReadOnly="True"
                 Text="{Binding Log, Mode=OneWay}"
                 TextChanged="OnLogTextChanged"
                 VerticalScrollBarVisibility="Auto" />
    </DockPanel>
</UserControl>