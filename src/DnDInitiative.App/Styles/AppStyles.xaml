<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  The heading at the top of every page.  -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!--  A heading inside a page.  -->
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!--  Less important text: hints, challenge ratings, the combat name.  -->
    <Style x:Key="SecondaryText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <!--  The outline around a panel.  -->
    <Style x:Key="PanelBorder" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <!--  One row in a list of stat blocks: name, challenge rating, and a tag on the user's own.  -->
    <DataTemplate x:Key="StatBlockSummaryTemplate">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Name}" />
            <TextBlock Margin="6,0,0,0"
                       Style="{StaticResource SecondaryText}"
                       Text="{Binding ChallengeRating, StringFormat='CR {0}'}" />
            <TextBlock x:Name="OwnTag"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                       Text="custom"
                       ToolTip="Your own stat block. It is saved in the campaign folder."
                       Visibility="Collapsed" />
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsOwn}" Value="True">
                <Setter TargetName="OwnTag" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>