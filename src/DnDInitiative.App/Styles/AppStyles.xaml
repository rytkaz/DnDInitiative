<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  The heading at the top of every page.  -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!--  A heading inside a page.  -->
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!--  Less important text: hints, challenge ratings, the combat name.  -->
    <Style x:Key="SecondaryText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <!--  The outline around a panel.  -->
    <Style x:Key="PanelBorder" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <!--
        The "printed page" look shared by the stat block card and the spell card.
        Fixed colours: the paper does not follow the light/dark theme.
    -->
    <SolidColorBrush x:Key="StatBlockPaper" Color="#FDF1DC" />
    <SolidColorBrush x:Key="StatBlockInk" Color="#1E1A16" />
    <SolidColorBrush x:Key="StatBlockAccent" Color="#7A200D" />
    <SolidColorBrush x:Key="StatBlockEdge" Color="#E69A28" />

    <!--  The rule that is thick on the left and tapers to a point on the right.  -->
    <Style x:Key="TaperedRule" TargetType="Polygon">
        <Setter Property="Points" Value="0,0 1,0.5 0,1" />
        <Setter Property="Stretch" Value="Fill" />
        <Setter Property="Height" Value="5" />
        <Setter Property="Margin" Value="0,8" />
        <Setter Property="Fill" Value="{StaticResource StatBlockAccent}" />
    </Style>

    <!--  A link in a card's text, such as a spell's name. Applied by MarkdownText.  -->
    <Style x:Key="MarkdownLink" TargetType="Hyperlink">
        <Setter Property="Foreground" Value="{StaticResource StatBlockAccent}" />
        <Setter Property="TextDecorations" Value="Underline" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#B5361A" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  One row in a list of stat blocks: name, challenge rating, and a tag on the user's own.  -->
    <DataTemplate x:Key="StatBlockSummaryTemplate">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Name}" />
            <TextBlock Margin="6,0,0,0"
                       Style="{StaticResource SecondaryText}"
                       Text="{Binding ChallengeRating, StringFormat='CR {0}'}" />
            <TextBlock x:Name="OwnTag"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                       Text="custom"
                       ToolTip="Your own stat block. It is saved in the campaign folder."
                       Visibility="Collapsed" />
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsOwn}" Value="True">
                <Setter TargetName="OwnTag" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>